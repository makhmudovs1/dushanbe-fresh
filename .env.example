DATABASE_URL="postgresql://dushanbe_fresh:dushanbe_fresh@localhost:5432/dushanbe_fresh?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# For an HTTPS demo: set WEB_ORIGIN to the exact public origin (no trailing slash).
# Set true for HTTPS tunnels; production always uses Secure cookies.
STAFF_COOKIE_SECURE=false
WEB_PORT=3000
# Optional Google Search Console HTML verification token (not a full meta tag).
# DNS verification does not require this variable. Set before building Web.
# GOOGLE_SITE_VERIFICATION=
# Next.js server-side proxy target, includes the API prefix.
API_URL="http://localhost:4000/api/v1"
# API image storage. Default: apps/api/var/product-images when started with pnpm dev.
# Production MUST set an absolute path backed by a persistent volume + backups.
# PRODUCT_IMAGES_DIR=/absolute/path/to/product-images
# Required in production: a random secret of at least 32 bytes. Never use the dev fallback.
# STAFF_JWT_SECRET=
# Customer login stays OFF until a real +992 SMS provider is connected and tested.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_REQUIRE_PHONE=false
# Independent random secret of at least 32 bytes; never reuse STAFF_JWT_SECRET.
# CUSTOMER_OTP_SECRET=
# Payom: full HTTPS endpoint supplied by Payom, ending in /api/message.
# Response contract is undocumented: adapter stays disabled until confirmed in code.
# See docs/PAYOM_SMS.md. Do not enable login merely after filling these variables.
# CUSTOMER_SMS_URL=https://HOST/api/message
# CUSTOMER_SMS_API_KEY=
# CUSTOMER_SMS_SENDER=
# Optional map tiles; loaded only when the customer opens the map.
# Geoapify server key: autocomplete/reverse only; NEVER prefix it NEXT_PUBLIC_.
# Put the real value in apps/web/.env.local or the Web process environment, not here.
# GEOAPIFY_API_KEY=
# Optional SEPARATE public tile key, restricted to website referrers in Geoapify.
# NEXT_PUBLIC_GEOAPIFY_MAP_API_KEY=
# Optional light tile style: positron (default) or osm-bright.
# NEXT_PUBLIC_GEOAPIFY_MAP_STYLE=positron
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=
# Legacy custom adapter fallback when GEOAPIFY_API_KEY is absent; see docs/GEOAPIFY.md.
# ADDRESS_SEARCH_URL=
# ADDRESS_SEARCH_API_KEY=
# ADDRESS_SEARCH_BOUNDS=[68.65,38.45,68.90,38.68]
# Optional passwords used only when creating dev staff (existing hashes are preserved).
# DEV_ADMIN_PASSWORD=
# DEV_PICKER_PASSWORD=
# DEV_COURIER_PASSWORD=
