{
  "name": "dushanbe-fresh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "docker compose up -d postgres && corepack pnpm --parallel --filter @dushanbe-fresh/shared --filter @dushanbe-fresh/api --filter @dushanbe-fresh/web dev",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "build": "corepack pnpm -r build",
    "build:web": "corepack pnpm --filter @dushanbe-fresh/web build",
    "build:api": "corepack pnpm --filter @dushanbe-fresh/api build",
    "db:generate": "corepack pnpm --filter @dushanbe-fresh/api db:generate",
    "db:migrate": "corepack pnpm --filter @dushanbe-fresh/api db:migrate",
    "db:deploy": "corepack pnpm --filter @dushanbe-fresh/api db:deploy",
    "db:seed": "corepack pnpm --filter @dushanbe-fresh/api db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.0",
    "eslint-config-next": "13.5.6",
    "typescript": "5.3.3",
    "vitest": "1.6.0"
  }
}
