{
  "name": "dushanbe-fresh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:share": "ngrok http http://localhost:${WEB_PORT:-3000} --inspect=false",
    "dev": "docker compose up -d postgres && corepack pnpm --parallel --filter @dushanbe-fresh/shared --filter @dushanbe-fresh/api --filter @dushanbe-fresh/web dev",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm --filter @dushanbe-fresh/shared build && corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "build": "corepack pnpm -r build",
    "build:web": "corepack pnpm --filter @dushanbe-fresh/shared build && corepack pnpm --filter @dushanbe-fresh/web build",
    "build:api": "corepack pnpm --filter @dushanbe-fresh/shared build && corepack pnpm --filter @dushanbe-fresh/api build",
    "db:generate": "corepack pnpm --filter @dushanbe-fresh/api db:generate",
    "db:backfill:images": "corepack pnpm --filter @dushanbe-fresh/api db:backfill:images",
    "db:import:pilot": "corepack pnpm --filter @dushanbe-fresh/api db:import:pilot",
    "db:fill:descriptions": "corepack pnpm --filter @dushanbe-fresh/api db:fill:descriptions",
    "db:migrate": "corepack pnpm --filter @dushanbe-fresh/api db:migrate",
    "db:deploy": "corepack pnpm --filter @dushanbe-fresh/api db:deploy",
    "db:seed": "corepack pnpm --filter @dushanbe-fresh/api db:seed",
    "db:seed:checkout": "corepack pnpm --filter @dushanbe-fresh/api db:seed:checkout",
    "db:validate": "corepack pnpm --filter @dushanbe-fresh/api db:validate",
    "db:seed:operations": "corepack pnpm --filter @dushanbe-fresh/api db:seed:operations",
    "db:seed:catalog": "corepack pnpm --filter @dushanbe-fresh/api db:seed",
    "db:seed:staff": "corepack pnpm --filter @dushanbe-fresh/api db:seed:staff",
    "db:reset:operations": "corepack pnpm --filter @dushanbe-fresh/api db:reset:operations"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "13.5.6",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.3.3",
    "vitest": "1.6.0"
  }
}
