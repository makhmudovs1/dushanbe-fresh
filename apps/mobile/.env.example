# Public configuration only. Never put credentials or Geoapify secrets here.
EXPO_PUBLIC_APP_ENV=development
# Physical phone: use your Mac LAN IP. Android emulator: 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_ASSET_URL=http://localhost:3000
EXPO_PUBLIC_ENABLE_ORDER_SUBMISSION=false
# Optional Android Maps SDK key restricted to package + signing certificate.
# GOOGLE_MAPS_ANDROID_API_KEY=
# Supply your registered IDs before EAS builds:
# MOBILE_APPLICATION_ID=tj.dushanbefresh.app
# EAS_PROJECT_ID=
