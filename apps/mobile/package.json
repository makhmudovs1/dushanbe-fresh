{
  "name": "@dushanbe-fresh/mobile",
  "version": "0.4.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint app src scripts app.config.ts vitest.config.ts --ext .ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "expo export --platform all --output-dir dist",
    "check:api": "tsx scripts/check-api.ts",
    "eas-build-post-install": "corepack pnpm --filter @dushanbe-fresh/shared build",
    "check:build": "node scripts/check-build-readiness.mjs",
    "check:android-startup": "node scripts/check-android-startup.mjs",
    "check:design": "node scripts/check-design-parity.mjs",
    "capture:reference": "node scripts/capture-web-reference.mjs"
  },
  "dependencies": {
    "@dushanbe-fresh/shared": "workspace:*",
    "@expo/vector-icons": "^15.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@types/node": "20.11.30",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "prettier": "3.6.2",
    "react-test-renderer": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
