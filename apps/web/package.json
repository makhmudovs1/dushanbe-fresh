{
  "name": "@dushanbe-fresh/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3000}",
    "lint": "eslint src e2e playwright.config.ts vitest.config.ts --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typegen": "next typegen",
    "test": "vitest run",
    "test:ui": "playwright test",
    "build": "next build"
  },
  "dependencies": {
    "@dushanbe-fresh/shared": "workspace:*",
    "@geoman-io/leaflet-geoman-free": "2.20.4",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "20.11.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
