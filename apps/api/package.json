{
  "name": "@dushanbe-fresh/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://dushanbe_fresh:dushanbe_fresh@localhost:5432/dushanbe_fresh?schema=public} prisma generate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://dushanbe_fresh:dushanbe_fresh@localhost:5432/dushanbe_fresh?schema=public} prisma migrate dev",
    "db:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://dushanbe_fresh:dushanbe_fresh@localhost:5432/dushanbe_fresh?schema=public} prisma migrate deploy",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://dushanbe_fresh:dushanbe_fresh@localhost:5432/dushanbe_fresh?schema=public} tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.3.10",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.3.10",
    "@nestjs/platform-express": "10.3.10",
    "@prisma/client": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "prisma": "5.22.0",
    "tsx": "4.7.1"
  }
}
