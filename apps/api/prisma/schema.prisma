generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  picker
  courier
}

enum UserStatus {
  active
  inactive
}

enum StaffRole {
  admin
  picker
  courier
}

enum OrderStatus {
  pending_review
  draft
  placed
  confirmed
  picking
  picked
  out_for_delivery
  delivered
  cancelled
}

enum PaymentMethod {
  cash_on_delivery
  manual_card_or_transfer
}

enum PaymentStatus {
  unpaid
  partial
  pending
  paid
  failed
  refunded
}

enum SubstitutionPolicy {
  replace_similar
  contact_me
  remove_item
}

enum OrderItemStatus {
  requested
  picked
  replaced
  removed
  unavailable
}

model User {
  id              String             @id @default(uuid())
  phone           String?            @unique
  email           String?            @unique
  passwordHash    String?            @map("password_hash")
  name            String?
  role            UserRole           @default(customer)
  roles           StaffRole[]        @default([])
  status          UserStatus         @default(active)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  addresses       CustomerAddress[]
  orders          Order[]            @relation("CustomerOrders")
  pickerWaves     DeliveryWave[]     @relation("PickerWaves")
  courierWaves    DeliveryWave[]     @relation("CourierWaves")
  refreshSessions RefreshSession[]
  auditActions    OperationalAudit[]

  @@map("users")
}

model OperationalAudit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entityId  String   @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityId, createdAt])
  @@map("operational_audit")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_sessions")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  label         String?
  recipientName String   @map("recipient_name")
  phone         String
  city          String
  street        String
  building      String
  apartment     String?
  entrance      String?
  floor         String?
  instructions  String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@map("customer_addresses")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id                   String                 @id @default(uuid())
  categoryId           String                 @map("category_id")
  name                 String
  slug                 String                 @unique
  description          String?
  imageUrl             String?                @map("image_url")
  unit                 String
  currentPurchasePrice Decimal                @map("current_purchase_price") @db.Decimal(12, 2)
  currentSalePrice     Decimal                @map("current_sale_price") @db.Decimal(12, 2)
  isWeighted           Boolean                @default(false) @map("is_weighted")
  minQuantity          Decimal                @map("min_quantity") @db.Decimal(12, 3)
  quantityStep         Decimal                @map("quantity_step") @db.Decimal(12, 3)
  isActive             Boolean                @default(true) @map("is_active")
  isAvailableToday     Boolean                @default(true) @map("is_available_today")
  deletedAt            DateTime?              @map("deleted_at")
  sortOrder            Int                    @default(0) @map("sort_order")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  category             Category               @relation(fields: [categoryId], references: [id])
  qualityOptions       ProductQualityOption[]
  orderItems           OrderItem[]
  replacementItems     OrderItem[]            @relation("ReplacementProduct")
  waveItems            WaveItem[]

  @@map("products")
}

model ProductQualityOption {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  label     String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_quality_options")
}

model DeliverySlot {
  id             String        @id @default(uuid())
  date           DateTime      @db.Date
  startsAt       DateTime      @map("starts_at") @db.Time
  endsAt         DateTime      @map("ends_at") @db.Time
  capacityOrders Int           @map("capacity_orders")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  wave           DeliveryWave?
  orders         Order[]

  @@map("delivery_slots")
}

model DeliveryWave {
  id             String       @id @default(uuid())
  deliverySlotId String       @unique @map("delivery_slot_id")
  status         String       @default("open")
  pickerUserId   String?      @map("picker_user_id")
  courierUserId  String?      @map("courier_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deliverySlot   DeliverySlot @relation(fields: [deliverySlotId], references: [id], onDelete: Cascade)
  picker         User?        @relation("PickerWaves", fields: [pickerUserId], references: [id])
  courier        User?        @relation("CourierWaves", fields: [courierUserId], references: [id])
  orders         Order[]
  waveItems      WaveItem[]

  @@map("delivery_waves")
}

model WaveItem {
  id                     String       @id @default(uuid())
  deliveryWaveId         String       @map("delivery_wave_id")
  productId              String       @map("product_id")
  productNameSnapshot    String       @map("product_name_snapshot")
  unit                   String
  requestedQuantityTotal Decimal      @map("requested_quantity_total") @db.Decimal(12, 3)
  purchasedQuantity      Decimal?     @map("purchased_quantity") @db.Decimal(12, 3)
  purchaseUnitPrice      Decimal?     @map("purchase_unit_price") @db.Decimal(12, 2)
  referencePurchasePrice Decimal?     @map("reference_purchase_price") @db.Decimal(12, 2)
  purchaseTotal          Decimal?     @map("purchase_total") @db.Decimal(12, 2)
  supplierNote           String?      @map("supplier_note")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  deliveryWave           DeliveryWave @relation(fields: [deliveryWaveId], references: [id], onDelete: Cascade)
  product                Product      @relation(fields: [productId], references: [id])

  @@unique([deliveryWaveId, productId])
  @@map("wave_items")
}

model Order {
  id                        String                     @id @default(uuid())
  orderNumber               String                     @unique @map("order_number")
  publicTrackingToken       String                     @unique @default(dbgenerated("(replace(gen_random_uuid()::text, '-'::text, ''::text) || replace(gen_random_uuid()::text, '-'::text, ''::text))")) @map("public_tracking_token")
  checkoutRequestId         String?                    @unique @map("checkout_request_id")
  checkoutRequestHash       String?                    @map("checkout_request_hash")
  legacyCustomerId          String?                    @map("customer_id")
  customerId                String?                    @map("guest_customer_id")
  addressId                 String?                    @map("address_id")
  deliveryAddressSnapshot   Json                       @map("delivery_address_snapshot")
  deliverySlotId            String                     @map("delivery_slot_id")
  deliveryWaveId            String?                    @map("delivery_wave_id")
  status                    OrderStatus                @default(placed)
  paymentMethod             PaymentMethod              @default(cash_on_delivery) @map("payment_method")
  paymentStatus             PaymentStatus              @default(pending) @map("payment_status")
  substitutionPolicy        SubstitutionPolicy         @map("substitution_policy")
  qualityComment            String?                    @map("quality_comment")
  itemsSubtotal             Decimal                    @map("items_subtotal") @db.Decimal(12, 2)
  deliveryFee               Decimal                    @map("delivery_fee") @db.Decimal(12, 2)
  serviceFee                Decimal                    @default(0) @map("service_fee") @db.Decimal(12, 2)
  discountTotal             Decimal                    @default(0) @map("discount_total") @db.Decimal(12, 2)
  totalEstimated            Decimal                    @map("total_estimated") @db.Decimal(12, 2)
  totalFinal                Decimal?                   @map("total_final") @db.Decimal(12, 2)
  customerComment           String?                    @map("customer_comment")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  legacyCustomer            User?                      @relation("CustomerOrders", fields: [legacyCustomerId], references: [id])
  customer                  Customer?                  @relation(fields: [customerId], references: [id])
  address                   CustomerAddress?           @relation(fields: [addressId], references: [id])
  deliverySlot              DeliverySlot               @relation(fields: [deliverySlotId], references: [id])
  deliveryWave              DeliveryWave?              @relation(fields: [deliveryWaveId], references: [id])
  items                     OrderItem[]
  serviceFeePercentSnapshot Decimal?                   @map("service_fee_percent_snapshot") @db.Decimal(5, 2)
  fulfillmentOutcome        FulfillmentOutcome         @default(full) @map("fulfillment_outcome")
  financialVersion          Int                        @default(0) @map("financial_version")
  deliveryClosedAt          DateTime?                  @map("delivery_closed_at")
  legacyPaidAmount          Decimal                    @default(0) @map("legacy_paid_amount") @db.Decimal(12, 2)
  orderKind                 String                     @default("customer") @map("order_kind")
  requiresPicking           Boolean                    @default(true) @map("requires_picking")
  issues                    DeliveryIssue[]
  attempts                  DeliveryAttempt[]
  adjustments               OrderFinancialAdjustment[]
  cashTransactions          CashTransaction[]
  paymentIssues             PaymentIssue[]
  replacements              ReplacementDelivery[]      @relation("OriginalReplacement")
  recovery                  ReplacementDelivery?       @relation("FulfillmentReplacement")

  @@index([deliverySlotId, status])
  @@index([deliveryWaveId])
  @@map("orders")
}

model OrderItem {
  id                         String              @id @default(uuid())
  orderId                    String              @map("order_id")
  productId                  String              @map("product_id")
  productNameSnapshot        String              @map("product_name_snapshot")
  unit                       String
  requestedQuantity          Decimal             @map("requested_quantity") @db.Decimal(12, 3)
  saleUnitPriceSnapshot      Decimal             @map("sale_unit_price_snapshot") @db.Decimal(12, 2)
  estimatedTotal             Decimal             @map("estimated_total") @db.Decimal(12, 2)
  purchaseUnitPriceSnapshot  Decimal?            @map("purchase_unit_price_snapshot") @db.Decimal(12, 2)
  qualityOptionId            String?             @map("quality_option_id")
  qualityOptionLabelSnapshot String?             @map("quality_option_label_snapshot")
  finalQuantity              Decimal?            @map("final_quantity") @db.Decimal(12, 3)
  finalUnitPrice             Decimal?            @map("final_unit_price") @db.Decimal(12, 2)
  finalTotal                 Decimal?            @map("final_total") @db.Decimal(12, 2)
  status                     OrderItemStatus     @default(requested)
  replacementProductId       String?             @map("replacement_product_id")
  pickerNote                 String?             @map("picker_note")
  order                      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                    Product             @relation(fields: [productId], references: [id])
  replacementProduct         Product?            @relation("ReplacementProduct", fields: [replacementProductId], references: [id])
  deliveryIssueItems         DeliveryIssueItem[]

  @@map("order_items")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum CustomerRisk {
  normal
  watch
  restricted
}

enum CodPolicy {
  allowed
  manual_review
  blocked
}

enum IssueReason {
  quality_problem
  damaged_item
  wrong_item
  missing_item_or_quantity
  customer_changed_mind
  customer_unreachable
  customer_not_home
  wrong_address
  delivery_delay
  payment_problem
  price_dispute
  other
}

enum Responsibility {
  service
  customer
  disputed
  unknown
}

enum IssueStatus {
  open
  awaiting_admin
  resolved
  rejected
}

enum ReviewStatus {
  pending
  confirmed
  rejected
}

enum CustomerVerification {
  not_checked
  customer_confirmed
  customer_disputed
}

enum IssueResolution {
  accept_rest_remove_items
  full_refusal
  replacement_later
  payment_issue
  escalate_to_admin
}

enum FulfillmentOutcome {
  full
  partial
  refused
  replacement_pending
  service_failure
}

enum AdjustmentType {
  goods_removed
  service_fee_reduction
  service_fee_waiver
  delivery_fee_waiver
  admin_compensation
  correction
}

enum CashType {
  collection
  cash_refund
  correction
}

enum ShiftStatus {
  open
  submitted
  reconciled
  discrepancy
}

model Customer {
  id                              String       @id @default(uuid())
  phoneNormalized                 String       @unique @map("phone_normalized")
  displayName                     String       @map("display_name")
  riskStatus                      CustomerRisk @default(normal) @map("risk_status")
  codPolicy                       CodPolicy    @default(allowed) @map("cod_policy")
  isActive                        Boolean      @default(true) @map("is_active")
  confirmedCustomerFaultIncidents Int          @default(0) @map("confirmed_customer_fault_incidents")
  unpaidIncidents                 Int          @default(0) @map("unpaid_incidents")
  adminNote                       String?      @map("admin_note")
  createdAt                       DateTime     @default(now()) @map("created_at")
  updatedAt                       DateTime     @updatedAt @map("updated_at")
  orders                          Order[]

  @@map("customers")
}

model DeliveryIssue {
  id                   String                     @id @default(uuid())
  orderId              String                     @map("order_id")
  createdByUserId      String                     @map("created_by_user_id")
  requestId            String                     @map("request_id")
  reason               IssueReason
  responsibility       Responsibility             @default(unknown)
  status               IssueStatus                @default(awaiting_admin)
  reviewStatus         ReviewStatus               @default(pending) @map("review_status")
  resolution           IssueResolution
  note                 String
  createdAt            DateTime                   @default(now()) @map("created_at")
  reviewedAt           DateTime?                  @map("reviewed_at")
  reviewedByUserId     String?                    @map("reviewed_by_user_id")
  reviewNote           String?                    @map("review_note")
  customerVerification CustomerVerification       @default(not_checked) @map("customer_verification")
  applied              Boolean                    @default(false)
  order                Order                      @relation(fields: [orderId], references: [id])
  items                DeliveryIssueItem[]
  adjustments          OrderFinancialAdjustment[]
  paymentIssue         PaymentIssue?
  replacement          ReplacementDelivery?

  @@unique([orderId, requestId])
  @@index([status, createdAt])
  @@map("delivery_issues")
}

model DeliveryIssueItem {
  id               String        @id @default(uuid())
  issueId          String        @map("issue_id")
  orderItemId      String        @map("order_item_id")
  quantityAffected Decimal       @map("quantity_affected") @db.Decimal(12, 3)
  issue            DeliveryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([issueId, orderItemId])
  @@map("delivery_issue_items")
}

model DeliveryAttempt {
  id             String      @id @default(uuid())
  orderId        String      @map("order_id")
  courierId      String      @map("courier_id")
  attemptedAt    DateTime    @default(now()) @map("attempted_at")
  reason         IssueReason
  note           String
  nextAction     String      @map("next_action")
  proposedSlotId String?     @map("proposed_slot_id")
  requestId      String      @map("request_id")
  order          Order       @relation(fields: [orderId], references: [id])

  @@unique([orderId, requestId])
  @@map("delivery_attempts")
}

model OrderFinancialAdjustment {
  id              String         @id @default(uuid())
  orderId         String         @map("order_id")
  deliveryIssueId String?        @map("delivery_issue_id")
  type            AdjustmentType
  amount          Decimal        @db.Decimal(12, 2)
  createdByUserId String         @map("created_by_user_id")
  reason          String
  requestId       String         @map("request_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  order           Order          @relation(fields: [orderId], references: [id])
  issue           DeliveryIssue? @relation(fields: [deliveryIssueId], references: [id])

  @@unique([orderId, requestId, type])
  @@map("order_financial_adjustments")
}

model PaymentIssue {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  courierId       String        @map("courier_id")
  deliveryIssueId String        @unique @map("delivery_issue_id")
  expectedAmount  Decimal       @map("expected_amount") @db.Decimal(12, 2)
  collectedAmount Decimal       @map("collected_amount") @db.Decimal(12, 2)
  variance        Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  order           Order         @relation(fields: [orderId], references: [id])
  issue           DeliveryIssue @relation(fields: [deliveryIssueId], references: [id])

  @@map("payment_issues")
}

model CourierShift {
  id               String            @id @default(uuid())
  courierId        String            @map("courier_id")
  openedAt         DateTime          @default(now()) @map("opened_at")
  closedAt         DateTime?         @map("closed_at")
  status           ShiftStatus       @default(open)
  expectedCash     Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  declaredCash     Decimal?          @map("declared_cash") @db.Decimal(12, 2)
  variance         Decimal?          @db.Decimal(12, 2)
  note             String?
  reviewedByUserId String?           @map("reviewed_by_user_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewNote       String?           @map("review_note")
  transactions     CashTransaction[]

  @@index([courierId, status])
  @@map("courier_shifts")
}

model CashTransaction {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  courierId       String        @map("courier_id")
  shiftId         String?       @map("shift_id")
  type            CashType
  amount          Decimal       @db.Decimal(12, 2)
  expectedAmount  Decimal?      @map("expected_amount") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  createdByUserId String        @map("created_by_user_id")
  note            String
  requestId       String        @map("request_id")
  order           Order         @relation(fields: [orderId], references: [id])
  shift           CourierShift? @relation(fields: [shiftId], references: [id])

  @@unique([orderId, requestId])
  @@map("cash_transactions")
}

model ReplacementDelivery {
  id                 String        @id @default(uuid())
  originalOrderId    String        @map("original_order_id")
  deliveryIssueId    String        @unique @map("delivery_issue_id")
  fulfillmentOrderId String        @unique @map("fulfillment_order_id")
  prepaid            Boolean
  createdAt          DateTime      @default(now()) @map("created_at")
  originalOrder      Order         @relation("OriginalReplacement", fields: [originalOrderId], references: [id])
  fulfillmentOrder   Order         @relation("FulfillmentReplacement", fields: [fulfillmentOrderId], references: [id])
  issue              DeliveryIssue @relation(fields: [deliveryIssueId], references: [id])

  @@map("replacement_deliveries")
}
