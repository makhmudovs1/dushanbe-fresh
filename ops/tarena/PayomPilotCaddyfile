{
    admin off
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    log default {
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
            }
        }
    }
}
dushanbefresh.tj, www.dushanbefresh.tj {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    log {
        output file /var/log/caddy/access.json {
            roll_size 5MiB
            roll_keep 3
        }
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
                user_id delete
            }
        }
    }
    handle /api/v1/* {
        reverse_proxy 127.0.0.1:4012 {
            header_up X-Forwarded-For {remote_host}
            header_up -Forwarded
            header_up -X-Real-IP
        }
    }
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-For {remote_host}
            header_up -Forwarded
            header_up -X-Real-IP
        }
    }
}
